flowchart LR
    ROOT["GEM SAATHI PLATFORM"]

    ROOT --> FR["Functional Requirements"]
    ROOT --> NFR["Non-Functional Requirements"]

    FR --> AWARENESS["GeM Awareness"]
    AWARENESS --> AWARE1["Explain what GeM is and why it matters"]
    AWARENESS --> AWARE2["Explain who can sell and how government buying works"]
    AWARENESS --> AWARE3["Define Udyam, L1, caution money and GMV inline"]
    AWARENESS --> AWARE4["Show current national and Maharashtra metrics with sources"]
    AWARENESS --> AWARE5["Guide users into Eligibility or a selected tool"]

    FR --> ELIGIBILITY["Eligibility and Classification Checker"]
    ELIGIBILITY --> ELIG1["Collect business type, GST, Udyam and offering details"]
    ELIGIBILITY --> ELIG2["Collect turnover, investment and supply experience"]
    ELIGIBILITY --> ELIG3["Calculate Micro, Small or Medium classification"]
    ELIGIBILITY --> ELIG4["Return Yes, Partial or No with reasoning"]
    ELIGIBILITY --> ELIG5["Name missing items, fix steps and realistic timelines"]
    ELIGIBILITY --> ELIG6["Record disqualified-by-choice separately"]

    FR --> FINANCE["Financial Decision Tools"]
    FINANCE --> REV["Estimate category revenue as a sourced range"]
    FINANCE --> PRICE["Calculate viable price and competitive margin"]
    FINANCE --> L1["Explain the L1 and MSE preference rule"]
    FINANCE --> ROI["Calculate registration effort, payback and projections"]
    FINANCE --> FEES["Apply configurable GeM fees and documented assumptions"]

    FR --> REPORT["Personalized Report"]
    REPORT --> REPORT1["Combine completed tool outputs on one page"]
    REPORT --> REPORT2["Reuse prior answers instead of asking twice"]
    REPORT --> REPORT3["Show sources, dates, ranges and caveats"]
    REPORT --> REPORT4["Send an optional report by WhatsApp or email"]
    REPORT --> REPORT5["Persist progress for returning users"]

    FR --> ONBOARD["Onboarding and Registration"]
    ONBOARD --> ONB1["Pre-fill an eight-step readiness checklist"]
    ONBOARD --> ONB2["Show the next action, time estimate and common mistakes"]
    ONBOARD --> ONB3["Deep-link to the official GeM registration portal"]
    ONBOARD --> ONB4["Let users confirm verified registration and first order"]
    ONBOARD --> ONB5["Offer workshop, CA partner and peer-seller support"]

    FR --> RESEARCH["Referral and Impact Measurement"]
    RESEARCH --> RES1["Capture source-specific referral codes"]
    RESEARCH --> RES2["Track awareness, tool completion and CTA events"]
    RESEARCH --> RES3["Track registration intent, verified registration and first order"]
    RESEARCH --> RES4["Measure time spent and cross-tool progression"]
    RESEARCH --> RES5["Export pseudonymous funnel data for research analysis"]

    FR --> ADMIN["Content and Data Operations"]
    ADMIN --> ADM1["Maintain bilingual explainer and guidance content"]
    ADMIN --> ADM2["Version eligibility, classification, pricing and ROI rules"]
    ADMIN --> ADM3["Import curated public benchmarks with source and vintage"]
    ADMIN --> ADM4["Manage categories, partners, workshops and referral links"]
    ADMIN --> ADM5["Review funnel metrics and data-quality warnings"]

    NFR --> USABILITY["Usability and Accessibility"]
    USABILITY --> USE1["Design mobile-first for SME owners"]
    USABILITY --> USE2["Support English and Hindi"]
    USABILITY --> USE3["Use plain language and define all jargon"]
    USABILITY --> USE4["Meet WCAG 2.2 AA accessibility targets"]
    USABILITY --> USE5["Ensure every result offers a useful next step"]

    NFR --> PERFORMANCE["Performance and Reliability"]
    PERFORMANCE --> PERF1["Remain usable on low-bandwidth mobile connections"]
    PERFORMANCE --> PERF2["Keep the initial bundle and media lightweight"]
    PERFORMANCE --> PERF3["Save answers locally before network submission"]
    PERFORMANCE --> PERF4["Use idempotent analytics and progress writes"]
    PERFORMANCE --> PERF5["Recover incomplete sessions without data loss"]

    NFR --> SECURITY["Security and Privacy"]
    SECURITY --> SEC1["Collect phone or email only with clear optional consent"]
    SECURITY --> SEC2["Encrypt data in transit and protect stored contact details"]
    SECURITY --> SEC3["Separate contact data from research event data"]
    SECURITY --> SEC4["Apply least-privilege roles to administration"]
    SECURITY --> SEC5["Support consent withdrawal, export and deletion"]
    SECURITY --> SEC6["Do not share data beyond approved partners without consent"]

    NFR --> TRUST["Trust and Data Quality"]
    TRUST --> TRUST1["Show source and vintage beside every numeric claim"]
    TRUST --> TRUST2["Present estimates as ranges with explicit assumptions"]
    TRUST --> TRUST3["Validate time and cost estimates with Pune SME journeys"]
    TRUST --> TRUST4["Flag stale, missing or unofficial benchmark data"]
    TRUST --> TRUST5["Keep an audit trail for rules and benchmark changes"]

    NFR --> QUALITY["Maintainability and Observability"]
    QUALITY --> QUAL1["Keep tool logic separate from presentation"]
    QUALITY --> QUAL2["Use typed, versioned calculation inputs and outputs"]
    QUALITY --> QUAL3["Test decision rules, formulas and critical user journeys"]
    QUALITY --> QUAL4["Monitor errors, latency and funnel-event delivery"]
    QUALITY --> QUAL5["Avoid storing raw sensitive values in application logs"]
